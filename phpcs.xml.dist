<?xml version="1.0"?>
<ruleset name="Translation Watchdog">
    <description>Security, database and i18n rules from the WordPress Coding Standards. Formatting rules are left out on purpose.</description>
    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array"><element value="translation-watchdog-for-translatepress"/></property>
        </properties>
    </rule>
    <rule ref="WordPress.PHP.DontExtract"/>
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>

    <!-- trwatch_kses() is wp_kses() with a fixed allowlist -->
    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customEscapingFunctions" type="array"><element value="trwatch_kses"/></property>
        </properties>
    </rule>
    <!-- trwatch_ajax_guard() runs check_ajax_referer() -->
    <rule ref="WordPress.Security.NonceVerification">
        <properties>
            <property name="customNonceVerificationFunctions" type="array"><element value="trwatch_ajax_guard"/></property>
        </properties>
    </rule>
</ruleset>
